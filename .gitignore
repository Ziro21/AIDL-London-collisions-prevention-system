# ── Data (never committed — download separately) ──────────────────────────────
data/raw/*.csv
data/processed/*.csv
data/processed/*.npy
!data/raw/.gitkeep
!data/processed/.gitkeep

# ── Model artefacts ───────────────────────────────────────────────────────────
outputs/models/*.pt
outputs/models/*.pkl
!outputs/models/.gitkeep

# ── Notebook checkpoints ──────────────────────────────────────────────────────
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.env

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
